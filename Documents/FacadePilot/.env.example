# FacadePilot — API Keys
# Kopieer dit bestand naar .env en vul je keys in

# OpenAI API key (voor GPT Image 2 renders + gpt-4o-mini quality check)
OPENAI_API_KEY=sk-proj-...

# Google Cloud API key (voor Street View Static API)
# Activeer "Street View Static API" in Google Cloud Console
# Gratis: $200/maand credit = ~28.500 foto's/maand
GOOGLE_API_KEY=AIza...

# ─── SUPABASE (CRM + landingpagina-tracking) ─────────────────────────
# Project: FacadePilot — https://supabase.com/dashboard/project/xndfyjhpmuaqaxndznji
SUPABASE_URL=https://xndfyjhpmuaqaxndznji.supabase.co

# Anon / publishable key (voor landingpagina, mag publiek)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhuZGZ5amhwbXVhcWF4bmR6bmppIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzczMTczNzgsImV4cCI6MjA5Mjg5MzM3OH0.I0Q4va68G3t-8PS-vMcoQlCCeEFROvptts8mMKb7xaY

# Landingpagina-contactformulieren schrijven naar een aparte tabel.
# Voer eerst supabase_form_submits.sql uit met RLS insert-only voor anon.
FACADEPILOT_FORM_SUBMITS_TABLE=form_submits
FACADEPILOT_PRIVACY_URL=/privacybeleid.html

# SERVICE ROLE key (volledige toegang — NIET committen, NIET in landing pages)
# Kopieer uit https://supabase.com/dashboard/project/xndfyjhpmuaqaxndznji/settings/api-keys
# (Project Settings -> API -> service_role key)
SUPABASE_SERVICE_KEY=eyJ...

# ─── PRINT.ONE (direct mail flyer-bezorging) ─────────────────────────
# Account: https://app.print.one
# Settings -> API keys -> aanmaken
# Default = DRY RUN; voor echte verzending gebruik --live flag of dry_run=False
PRINTONE_API_KEY=
