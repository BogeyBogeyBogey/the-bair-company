# HomePilot shared platform configuration.
# Copy this file to .env for local operator use. Never commit real credentials.

# Preferred names for the central HomePilot Supabase project.
HOMEPILOT_SUPABASE_URL=https://replace-project-ref.supabase.co
HOMEPILOT_SUPABASE_SERVICE_KEY=replace-service-role-key
HOMEPILOT_SUPABASE_ANON_KEY=replace-anon-key
HOMEPILOT_SUPABASE_DB_URL=postgresql://postgres:replace-db-password@db.replace-project-ref.supabase.co:5432/postgres

# Fallback names accepted by the platform tools.
SUPABASE_URL=https://replace-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-service-role-key
SUPABASE_ANON_KEY=replace-anon-key
SUPABASE_DB_URL=postgresql://postgres:replace-db-password@db.replace-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:replace-db-password@db.replace-project-ref.supabase.co:5432/postgres

# Live schema verification reads metadata via psql and does not store the URL:
# python3 platform/homepilot_live_schema_verification.py \
#   --out-dir /tmp/homepilot_schema_verification_live \
#   --live

# Live readiness tells you exactly which live credentials/evidence are still missing:
# python3 platform/homepilot_live_readiness.py \
#   --out-dir /tmp/homepilot_live_readiness \
#   --readiness-report /tmp/homepilot_readiness_market_ready/readiness_report.json \
#   --due-diligence-report /tmp/homepilot_due_diligence_market_ready/due_diligence_report.json \
#   --account-access-plan /tmp/homepilot_readiness_market_ready/account_access_smoke/account_access_plan.json

# Live RLS launch fixture credentials should be provided via environment
# variables or a secret manager so they do not appear in shell history.
# HOMEPILOT_RLS_WINDOW_EMAIL=window.rls@example.com
# HOMEPILOT_RLS_WINDOW_PASSWORD=replace-strong-window-password
# HOMEPILOT_RLS_FACADE_EMAIL=facade.rls@example.com
# HOMEPILOT_RLS_FACADE_PASSWORD=replace-strong-facade-password
# HOMEPILOT_RLS_FACADE_PARTNER_EMAIL=facade.partner.rls@example.com
# HOMEPILOT_RLS_FACADE_PARTNER_PASSWORD=replace-strong-facade-partner-password

# Live RLS launch fixture can still accept CLI overrides when needed:
# python3 platform/homepilot_launch.py rls-fixture --out-dir /tmp/homepilot_launch_live \
#   --window-email window.rls@example.com --window-password 'replace-strong-window-password' \
#   --facade-email facade.rls@example.com --facade-password 'replace-strong-facade-password'

# Customer access verification reads per-invitee credentials from environment
# variables named in CUSTOMER_ACCESS_VERIFICATION.md / customer_access_probe_contract.json.
# Prefer short-lived access tokens; do not commit real values.
# HOMEPILOT_ACCESS_OWNER_CUSTOMER_EXAMPLE_COM_TOKEN=replace-short-lived-token
# HOMEPILOT_ACCESS_OWNER_CUSTOMER_EXAMPLE_COM_PASSWORD=replace-only-for-live-verification
